# Python bytecode cache directories at any depth.
**/__pycache__/

# Local editor settings and Hygon scratch directories at any depth.
**/.vscode/
**/hygon_tmp/

# Lock, journal and backup files written by moe_tune when it installs configs.
/aiter/configs/.moe_tune_*

# Rebuild working copies, logs and wheel packages.
/build/
/dist/

# AITER JIT build artifacts and local install markers.
/aiter/jit/build/
/aiter/jit/*.so
/aiter/install_mode
/aiter.egg-info/
/aiter_meta/
